### Test Submit Exam Functionality
### Base URL
@baseUrl = http://localhost:5211
@adminEmail = admin@pied.com
@adminPassword = AdminPassword123!
@teacherEmail = teacher@pied.com
@teacherPassword = TeacherPassword123!

### Variables (will be set after each request)
@adminToken = 
@teacherToken = 
@studentToken = 
@studentId = 
@examId = 
@examRoomId = 
@roomCode = 
@participationId = 

###############################################
### 1. Login as Admin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

###############################################
### 2. Create a Student Account
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "student1@test.com",
  "password": "Student123!",
  "firstName": "Test",
  "lastName": "Student",
  "role": "Student"
}

###############################################
### 3. Login as Student
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "student1@test.com",
  "password": "Student123!"
}

###############################################
### 4. Login as Teacher to Create Exam
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{teacherEmail}}",
  "password": "{{teacherPassword}}"
}

###############################################
### 5. Create an Exam (as Teacher)
POST {{baseUrl}}/api/exams
Content-Type: application/json
Authorization: Bearer {{teacherToken}}

{
  "title": "C Programming Test",
  "description": "Basic C programming exam with test cases",
  "totalMarks": 100,
  "passingMarks": 60
}

###############################################
### 6. Create Exam Room (as Teacher)
POST {{baseUrl}}/api/exam-rooms
Content-Type: application/json
Authorization: Bearer {{teacherToken}}

{
  "name": "C Programming Room 1",
  "description": "First C programming exam room",
  "startTime": "2026-02-26T14:00:00Z",
  "endTime": "2026-02-26T16:00:00Z",
  "durationInMinutes": 60
}

###############################################
### 7. Assign Exam to Room (as Teacher)
POST {{baseUrl}}/api/exam-rooms/{{examRoomId}}/exams/{{examId}}
Authorization: Bearer {{teacherToken}}

###############################################
### 8. Enroll Student to Exam Room (as Teacher)
POST {{baseUrl}}/api/exam-rooms/{{examRoomId}}/enroll
Content-Type: application/json
Authorization: Bearer {{teacherToken}}

{
  "studentIds": ["{{studentId}}"]
}

###############################################
### 9. Student Checks Available Exam Rooms
GET {{baseUrl}}/api/exam-rooms/available
Authorization: Bearer {{studentToken}}

###############################################
### 10. Student Starts Exam
POST {{baseUrl}}/api/participations/start
Content-Type: application/json
Authorization: Bearer {{studentToken}}

{
  "roomCode": "{{roomCode}}",
  "examId": "{{examId}}"
}

###############################################
### 11. Student Submits Answer (First Time - Auto Save)
POST {{baseUrl}}/api/participations/submit
Content-Type: application/json
Authorization: Bearer {{studentToken}}

{
  "participationId": "{{participationId}}",
  "answers": [
    {
      "questionId": "00000000-0000-0000-0000-000000000001",
      "answer": "#include <stdio.h>\n\nint main() {\n    printf(\"Hello World\");\n    return 0;\n}"
    }
  ],
  "isFinalSubmission": false
}

###############################################
### 12. Student Updates Answer (Second Time - Auto Save)
POST {{baseUrl}}/api/participations/submit
Content-Type: application/json
Authorization: Bearer {{studentToken}}

{
  "participationId": "{{participationId}}",
  "answers": [
    {
      "questionId": "00000000-0000-0000-0000-000000000001",
      "answer": "#include <stdio.h>\n\nint main() {\n    printf(\"Hello World\\n\");\n    return 0;\n}"
    }
  ],
  "isFinalSubmission": false
}

###############################################
### 13. Student Submits Final Answer
POST {{baseUrl}}/api/participations/submit
Content-Type: application/json
Authorization: Bearer {{studentToken}}

{
  "participationId": "{{participationId}}",
  "answers": [
    {
      "questionId": "00000000-0000-0000-0000-000000000001",
      "answer": "#include <stdio.h>\n\nint main() {\n    printf(\"Hello World\\n\");\n    return 0;\n}"
    }
  ],
  "isFinalSubmission": true
}

###############################################
### 14. Try to Submit Again After Final (Should Fail)
POST {{baseUrl}}/api/participations/submit
Content-Type: application/json
Authorization: Bearer {{studentToken}}

{
  "participationId": "{{participationId}}",
  "answers": [
    {
      "questionId": "00000000-0000-0000-0000-000000000001",
      "answer": "#include <stdio.h>\n\nint main() {\n    printf(\"Modified after final\");\n    return 0;\n}"
    }
  ],
  "isFinalSubmission": false
}

###############################################
### 15. Get Student Participations
GET {{baseUrl}}/api/participations?pageNumber=1&pageSize=10
Authorization: Bearer {{studentToken}}

###############################################
### 16. Teacher Gets Exam Room Enrollments
GET {{baseUrl}}/api/participations/room/{{examRoomId}}?pageNumber=1&pageSize=10
Authorization: Bearer {{teacherToken}}
